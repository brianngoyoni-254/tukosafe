# TukoSafe environment template.
#
# 1. Copy this file to .env.local   (cp .env.example .env.local)   -- .env.local is git-ignored.
# 2. In the Supabase dashboard open  Project Settings > API  and copy:
#      "Project URL"                      -> VITE_SUPABASE_URL
#      "anon" / "publishable" public key  -> VITE_SUPABASE_PUBLISHABLE_KEY
# 3. Restart `npm run dev` (Vite only reads this file at start-up).
# 4. Check the connection:  npm run check:supabase
#
# Only PUBLIC values belong here. Never put the service_role / secret key in any VITE_* variable:
# everything prefixed VITE_ is shipped to every visitor's browser.
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR-PUBLIC-PUBLISHABLE-OR-ANON-KEY
# Older projects may use this name instead; either one works (the publishable one wins if both are set):
# VITE_SUPABASE_ANON_KEY=

# Public VAPID key for web push (generate with: npx web-push generate-vapid-keys). Safe to expose.
VITE_VAPID_PUBLIC_KEY=

# ---- Server-side secrets: set with `supabase secrets set`, NEVER in a VITE_* variable ----
# DELIVERY_SECRET=long-random-string            (shared with the database, see README)
# VAPID_PUBLIC_KEY=...  VAPID_PRIVATE_KEY=...  VAPID_SUBJECT=mailto:you@example.com
# RESEND_API_KEY=...    EMAIL_FROM="TukoSafe <alerts@your-domain>"
# AT_API_KEY=...        AT_USERNAME=...   AT_SENDER_ID=(optional)   AT_SANDBOX=true|false
