# ---- App ----
APP_NAME=TukoSafe API
DEBUG=true
SECRET_KEY=change-me-in-production-use-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ---- Database ----
# Local hackathon default (SQLite, zero setup):
DATABASE_URL=sqlite:///./tukosafe.db
# Production (PostgreSQL):
# DATABASE_URL=postgresql+psycopg2://tukosafe:tukosafe@localhost:5432/tukosafe

# ---- Realtime / workers ----
# Optional. App works without Redis (in-process scheduler + in-memory WS fan-out).
REDIS_URL=
# REDIS_URL=redis://localhost:6379/0

# ---- Notifications ----
# Firebase Cloud Messaging (push). Leave empty for log-mode (demo friendly).
FIREBASE_CREDENTIALS_PATH=
# FIREBASE_CREDENTIALS_PATH=/app/firebase-service-account.json
# Africa's Talking (SMS). Leave empty for log-mode.
AT_USERNAME=
AT_API_KEY=
AT_SENDER_ID=TUKOSAFE
# When true, /auth/otp/request returns the code in the response (DEV/DEMO ONLY).
OTP_DEBUG_RETURN=true

# ---- Privacy / retention ----
LOCATION_RETENTION_DAYS=7
DEFAULT_CHECKIN_INTERVAL_MIN=60
DEFAULT_GRACE_MIN=15

# ---- CORS ----
CORS_ORIGINS=*
